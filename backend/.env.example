# Backend Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEBUG=false

# Database - MongoDB Atlas or local
# Use MONGODB_URI for MongoDB Atlas and other cloud deployments
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Fallback to DATABASE_URL or defaults to mongodb://localhost:27017/ai-platform
MONGODB_URI=
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
# Set a unique local development secret. Production must use a strong, unique secret.
JWT_SECRET=replace-with-unique-local-development-secret
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# API
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Job Queue
JOB_QUEUE_NAME=ai-tasks
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000
JOB_TIMEOUT=300000

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/tmp/ai-platform-storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-with-local-minio-access-key
S3_SECRET_KEY=replace-with-local-minio-secret-key
S3_BUCKET=ai-platform
S3_REGION=us-east-1

# Agnes AI Provider
AGNES_ENABLED=true
AGNES_API_KEY=
AGNES_API_URL=https://api.agnes.ai
AGNES_TIMEOUT=300000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
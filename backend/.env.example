# Backend Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEBUG=false

# Database
MONGODB_URI=
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-unique-local-development-secret
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# API
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Job Queue
JOB_QUEUE_NAME=ai-tasks
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000
JOB_TIMEOUT=300000

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/tmp/ai-platform-storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-platform
S3_REGION=us-east-1

# Optional hosted model integrations
GOOGLE_GEMMA_API_KEY=
NVIDIA_API_KEY=

# Agnes AI Provider (optional)
AGNES_ENABLED=false
AGNES_API_KEY=
AGNES_API_URL=https://api.agnes.ai
AGNES_TIMEOUT=300000

# Keyless Pollinations text + image generation (enabled by default; set false to opt out).\nPOLLINATIONS_ENABLED=true\nPOLLINATIONS_TEXT_BASE_URL=https://text.pollinations.ai\nPOLLINATIONS_TIMEOUT=90000\n\n# Groq text reasoning adapter for the 3D scene-design agent (requires your own Groq API key).\nGROQ_ENABLED=false\nGROQ_API_KEY=\nGROQ_BASE_URL=https://api.groq.com/openai/v1\nGROQ_MODEL=llama-3.3-70b-versatile\nGROQ_3D_MODEL=llama-3.3-70b-versatile\nGROQ_TIMEOUT=90000\n\n# Gemini 2.5 Flash is the first hosted text route.
GEMINI_ENABLED=false
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30000

# NVIDIA NIM is the next optional text route.
# Keep disabled until account entitlement and billing behavior are verified.
NVIDIA_NIM_ENABLED=false
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=openai/gpt-oss-20b
NVIDIA_NIM_RPM_PER_MODEL=40
NVIDIA_NIM_TIMEOUT=120000
NVIDIA_NIM_BILLING_MODE=unknown
NVIDIA_NIM_ALLOW_PAID=false

# Backward-compatible alias; canonical paid opt-in is NVIDIA_NIM_ALLOW_PAID.
NVIDIA_NIM_ALLOW_PAID_USAGE=false

# Text Pool Provider order. Unconfigured providers are skipped.
TEXT_PROVIDER_FALLBACK_ORDER=groq,pollinations,gemini,nvidia-nim,openrouter,ollama,opencode-free,opencode-acp,opencode-zen
PROVIDER_POOL_MAX_ATTEMPTS=3


# OpenCode provider family (all disabled by default)
# OpenCode Free is a local CLI route; it does not provide free hosted inference.
OPENCODE_FREE_ENABLED=false
OPENCODE_FREE_COMMAND=opencode
OPENCODE_FREE_MODEL=
OPENCODE_FREE_TIMEOUT=120000

# OpenCode Zen is an optional metered API; enable only after checking billing.
OPENCODE_ZEN_ENABLED=false
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=minimax-m2.5-free
OPENCODE_ZEN_TIMEOUT=90000

# ACP is a local OpenCode agent subprocess over stdio.
OPENCODE_ACP_ENABLED=false
OPENCODE_ACP_COMMAND=opencode
OPENCODE_ACP_ARGS=acp
OPENCODE_ACP_CWD=
OPENCODE_ACP_TIMEOUT=120000

# Self-hosted Unreal Engine 5 worker (optional)
UE5_WORKER_URL=
UE5_WORKER_TOKEN=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
WEBHOOK_SIGNING_SECRET=

# Backend Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEBUG=false

# Database - MongoDB Atlas or local
# Use MONGODB_URI for MongoDB Atlas and other cloud deployments
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Fallback to DATABASE_URL or defaults to mongodb://localhost:27017/ai-platform
MONGODB_URI=
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# API
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Job Queue
JOB_QUEUE_NAME=ai-tasks
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000
JOB_TIMEOUT=300000

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/tmp/ai-platform-storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-platform
S3_REGION=us-east-1

# OpenRouter unified multimodal API (text, image, video, audio, TTS, STT)
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT=180000
OPENROUTER_VIDEO_MAX_POLLS=60
OPENROUTER_VIDEO_POLL_MS=5000
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=SINA AI STUDIO

# Hugging Face Hub catalog discovery (public model metadata; optional token for gated/private visibility)
HUGGINGFACE_TOKEN=
HUGGINGFACE_TIMEOUT=15000

# Agnes AI Provider
AGNES_ENABLED=true
AGNES_API_KEY=
AGNES_API_URL=https://api.agnes.ai
AGNES_TIMEOUT=300000


# Self-hosted Unreal Engine 5 room worker (optional; never commit real values)
# Use an HTTPS URL for remote workers. Localhost HTTP is allowed for development.
UE5_WORKER_URL=
UE5_WORKER_TOKEN=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
# Job webhooks (required to deliver signed lifecycle callbacks)
# Generate a random secret with at least 32 characters; never commit the real value.
WEBHOOK_SIGNING_SECRET=

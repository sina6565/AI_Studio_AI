# Backend Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEBUG=false

# Database
MONGODB_URI=
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-unique-local-development-secret
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# API
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Job Queue
JOB_QUEUE_NAME=ai-tasks
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000
JOB_TIMEOUT=300000

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/tmp/ai-platform-storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-platform
S3_REGION=us-east-1

# Agnes AI Provider (optional)
AGNES_ENABLED=false
AGNES_API_KEY=
AGNES_API_URL=https://api.agnes.ai
AGNES_TIMEOUT=300000

# Google Gemini 2.5 Flash (optional; free-tier access depends on project quotas)
GEMINI_ENABLED=false
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30000

# Self-hosted Unreal Engine 5 worker (optional)
UE5_WORKER_URL=
UE5_WORKER_TOKEN=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
WEBHOOK_SIGNING_SECRET=

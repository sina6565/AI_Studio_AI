# Mobile configuration.
#
# Copy this file to `.env` (git-ignored) and adjust it for your environment.
# Values are injected at build time by react-native-dotenv (see babel.config.js).
#
# The app already falls back to a sensible per-platform default when API_URL is
# unset: the Android emulator reaches the host machine through 10.0.2.2, while
# the iOS simulator uses localhost. Set API_URL explicitly to target a physical
# device on your LAN or a deployed backend.
#
# Never put provider/API secrets here: anything in `.env` is bundled into the
# application. Only the public backend base URL belongs in this file.
API_URL=http://10.0.2.2:3000/api
ENVIRONMENT=development
